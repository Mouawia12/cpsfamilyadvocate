APP_NAME=Familist
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8035

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local dev uses SQLite (database/database.sqlite). Production (cPanel) uses MySQL:
# DB_CONNECTION=mysql
# DB_HOST=localhost
# DB_PORT=3306
# DB_DATABASE=familist
# DB_USERNAME=
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="familist@cpsfamilyadvocate.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Familist frontend / API integration ---
# Public site origin. Stripe success/cancel redirects are built from it.
FRONTEND_URL=http://localhost:3030
CORS_ALLOWED_ORIGINS=http://localhost:3030
SANCTUM_STATEFUL_DOMAINS=localhost:3030

# Where booking / enrollment / lead notifications are emailed.
CONTACT_TO_EMAIL="familist@cpsfamilyadvocate.com"

# --- Stripe (leave BLANK until the keys are ready) ---
# The secret key never reaches the browser: checkout sessions are created here.
# When empty, requests are recorded as "pending" and the team is emailed.
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
