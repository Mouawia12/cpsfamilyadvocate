# public/ holds both index.php and the built SPA shell index.html. The shell must
# always go through Laravel (SEO tags + data), never be served directly.
DirectoryIndex index.php

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # HTTP → HTTPS is left to the panel ("Force HTTPS" in cPanel / HestiaCP): behind
    # a TLS-terminating proxy Apache can see plain http and a rule here would loop.

    # One canonical host: www.cpsfamilyadvocate.com
    RewriteCond %{HTTP_HOST} ^cpsfamilyadvocate\.com$ [NC]
    RewriteRule ^ https://www.cpsfamilyadvocate.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # The SPA shell must go through Laravel (it injects SEO tags and data).
    RewriteRule ^index\.html$ / [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Built assets have content hashes in their names: cache them for a year.
<IfModule mod_headers.c>
    <If "%{REQUEST_URI} =~ m#^/assets/#">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </If>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml image/svg+xml
</IfModule>

# Never serve dotfiles such as .env if the document root is misconfigured.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
